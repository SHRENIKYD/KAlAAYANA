---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ImagePreview from '../../components/ImagePreview.astro';
import { photo, photoWidths } from '../../lib/photos';
import site from '../../data/site.json';
import projects from '../../data/projects.json';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { section: project.group, slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const key = project.group;
const section = site.sections[key];
const gallery = project.images.map((image, index) => {
  const source = photo(image.file);
  return { ...image, source, orientation: source.height > source.width ? 'portrait' : 'landscape' };
});
const fonts =
  'https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap';
---

<Base
  title={`${project.title} — ${site.name}`}
  description={project.description}
  fonts={fonts}
  bodyClass="motion-inner detail-page"
>
  <link slot="head" rel="stylesheet" href="/motion/inner.css?v=1.2.1" />
  <link slot="head" rel="stylesheet" href="/motion/project.css?v=1.2.1" />

  <header class="detail-nav">
    <a class="detail-back" href={`/${key}/`}>
      ← {section.eyebrow}
    </a>
  </header>

  <main>
    {gallery.length > 0 && (
      <section
        class="detail-gallery"
        data-image-count={gallery.length}
        style={`--gallery-columns: ${Math.min(gallery.length, 3)}; --gallery-mobile-columns: ${Math.min(gallery.length, 2)}`}
        aria-label={`${project.title} photographs`}
      >
        {gallery.map((image, index) => (
          <figure
            class={image.orientation}
            role="button"
            tabindex="0"
            data-preview-index={index}
            aria-label={`View ${image.alt}`}
          >
            <Image
              src={image.source}
              alt={image.alt}
              widths={photoWidths(image.source)}
              formats={['avif', 'webp']}
              loading="lazy"
              quality={95}
              sizes={
                gallery.length <= 2
                  ? '(max-width: 760px) 90vw, (max-width: 1500px) 45vw, 1100px'
                  : '(max-width: 760px) 44vw, (max-width: 1300px) 44vw, 30vw'
              }
            />
            {image.generated && (
              <figcaption class="finish-visualization">
                AI-generated finish visualization
              </figcaption>
            )}
          </figure>
        ))}
      </section>
    )}
  </main>
  <ImagePreview title={project.title} />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('.detail-gallery').forEach((gallery) => {
    if (Number(gallery.dataset.imageCount) <= 2) return;
    let frame = 0;
    const pack = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        gallery.classList.add('masonry-ready');
        const gap = parseFloat(getComputedStyle(gallery).rowGap);
        gallery.querySelectorAll<HTMLElement>('figure').forEach((figure) => {
          const height = figure.getBoundingClientRect().height;
          figure.style.gridRowEnd = `span ${Math.ceil((height + gap) / (1 + gap))}`;
        });
      });
    };
    const observer = new ResizeObserver(pack);
    gallery.querySelectorAll('figure').forEach((figure) => observer.observe(figure));
    pack();
  });
</script>

<style is:global>
  body.detail-page main .detail-gallery {
    display: grid;
    grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
    gap: 20px;
    align-items: start;
  }
  body.detail-page main .detail-gallery.masonry-ready {
    grid-auto-rows: 1px;
  }
  body.detail-page main .detail-gallery figure {
    display: inline-block;
    vertical-align: top;
    width: 100%;
    margin: 0;
    break-inside: avoid;
    border-radius: 16px;
    overflow: hidden;
  }
  body.detail-page main .detail-gallery img {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    object-fit: contain;
  }
  body.detail-page main .detail-gallery:is([data-image-count='1'], [data-image-count='2']) {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 24px;
    min-height: calc(100svh - 150px);
    columns: auto;
  }
  body.detail-page main .detail-gallery:is([data-image-count='1'], [data-image-count='2']) figure {
    flex: 0 1 680px;
    margin: 0;
    min-width: 0;
  }
  body.detail-page main .detail-gallery[data-image-count='1'] figure.landscape {
    flex-basis: 1100px;
  }
  body.detail-page main .detail-gallery:is([data-image-count='1'], [data-image-count='2']) img {
    width: auto;
    max-width: 100%;
    max-height: 78svh;
    margin-inline: auto;
    border-radius: 16px;
    object-fit: contain;
  }
  @media (max-width: 760px) {
    body.detail-page main .detail-gallery[data-image-count='1'] figure.landscape {
      flex: none;
    }
    body.detail-page main .detail-gallery {
      grid-template-columns: repeat(var(--gallery-mobile-columns), minmax(0, 1fr));
    }
    body.detail-page main .detail-gallery:is([data-image-count='1'], [data-image-count='2']) {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    body.detail-page
      main
      .detail-gallery:is([data-image-count='1'], [data-image-count='2'])
      figure {
      flex: none;
      width: 100%;
    }
    body.detail-page main .detail-gallery:is([data-image-count='1'], [data-image-count='2']) img {
      max-height: none;
    }
  }
</style>
