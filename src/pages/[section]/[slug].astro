---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { photo, photoWidths } from '../../lib/photos';
import site from '../../data/site.json';
import projects from '../../data/projects.json';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { section: project.group, slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const key = project.group;
const section = site.sections[key];
const gallery = project.images.map((image, index) => {
  const source = photo(image.file);
  return { ...image, source, orientation: source.height > source.width ? 'portrait' : 'landscape' };
});
const fonts = 'https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap';
---
<Base title={`${project.title} — ${site.name}`} description={project.description} fonts={fonts} bodyClass="motion-inner detail-page">
  <link slot="head" rel="stylesheet" href="/motion/inner.css?v=1.2.1">
  <link slot="head" rel="stylesheet" href="/motion/project.css?v=1.2.1">

  <header class="detail-nav">
    <a class="detail-back" href={`/${key}.html`}>← {section.eyebrow}</a>
  </header>

  <main>
    {gallery.length > 0 && <section class="detail-gallery" aria-label={`${project.title} photographs`}>
      {gallery.map((image) => <figure class={image.orientation}><Image src={image.source} alt={image.alt} widths={photoWidths(image.source)} formats={['avif', 'webp']} loading="lazy" quality={95} sizes="(max-width: 760px) 90vw, (max-width: 1600px) 45vw, 736px" />{image.generated && <figcaption class="finish-visualization">AI-generated finish visualization</figcaption>}</figure>)}
    </section>}

  </main>
</Base>
