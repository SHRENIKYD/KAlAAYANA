---
/**
 * Homepage. The slider and the archive strip derive every collection fact —
 * name, count, order, photograph — from site.json and projects.json, which is
 * where the collection pages and archive.astro already read them from.
 *
 * Before this, the counts were typed into the markup and all four were wrong
 * (18/12/09/24 against 9/9/7/4) with the fifth collection missing entirely.
 * They are correct in the markup today; deriving them is what stops that
 * recurring. The structure, class names and order are unchanged.
 */
import { Image } from 'astro:assets';
import { banner } from '../lib/photos';
import site from '../data/site.json';
import projects from '../data/projects.json';

const collections = Object.entries(site.sections).map(([key, section], index) => ({
  key,
  ...section,
  n: String(index + 1).padStart(2, '0'),
  count: projects.filter((project) => project.group === key).length,
  /** The slider alternates ground colour; hold that by position, not by hand. */
  invert: index % 2 === 1,
}));
const total = String(collections.length).padStart(2, '0');

/**
 * The hero used to read "Selected works · 2012—2026". No project carried a
 * year, so the range rested on nobody's memory in particular. It is derived
 * from the data now: silent while no year is recorded, and correct by
 * construction the moment they are.
 */
const years = projects.map((project) => parseInt(project.year, 10)).filter(Number.isFinite);
const heroWorks = years.length
  ? `Selected works · ${Math.min(...years)}—${Math.max(...years)}`
  : 'Selected works';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="index,follow">
  <meta name="description" content="Kalaayana Studios — monumental sculpture and sacred art shaped in Bengaluru.">\n  <link rel="canonical" href="https://kalaayanastudios.com/">
  <title>Kalaayana Studios — Art in Motion</title>
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/assets/img/favicon-16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="stylesheet" href="/motion/styles.css?v=1.2.9">
  <link rel="stylesheet" href="/motion/effects.css?v=1.2.9">
