  <link rel="stylesheet" href="/motion/routing.css?v=1.2.9">
  <link rel="stylesheet" href="/motion/responsive.css?v=1.2.9">
  <link rel="stylesheet" href="/motion/rework.css?v=1.3.0">
  <script is:inline>try{sessionStorage.setItem("kal-boot","1")}catch(e){}</script>
</head>
<body>
  <div class="scroll-progress" aria-hidden="true"></div>
  <header class="nav">
    <a class="logo" href="#home"><img src="/motion/assets/logo.svg" alt="Kalaayana Studios"></a>
    <p>SCULPTURE STUDIO<br>BENGALURU, INDIA</p>
    <div class="nav-actions"><button class="menu" aria-label="Open navigation"><span>MENU</span><i></i></button></div>
  </header>
  <aside class="menu-panel" aria-hidden="true"><img class="menu-logo" src="/motion/assets/logo.svg" alt="Kalaayana Studios"><button class="menu-close">CLOSE ×</button><div class="menu-preview"><img src="/motion/assets/hero-hanuman.jpg" alt="Monumental Hanuman sculpture under construction"></div><nav><a href="#home"><b>01</b>Index</a><a href="#works"><b>02</b>Selected works</a><a href="/archive.html"><b>03</b>Archive</a><a href="#contact"><b>04</b>Contact</a></nav><div class="menu-meta">KALAAYANA STUDIOS · BENGALURU</div></aside>
  <main>
    <section class="hero" id="home"><div class="hero-sticky">
      <div class="hero-image" data-zoom><img src="/motion/assets/hero-hanuman.jpg" alt="Monumental Hanuman sculpture being created"></div><div class="hero-shade"></div>
      <div class="hero-title"><div class="hero-kicker">ART · HERITAGE · DEVOTION</div><h1><span>WE SHAPE</span><span>THE <i>TIMELESS.</i></span></h1></div>
      <div class="hero-foot"><span>{heroWorks}</span><a href="#approach">Scroll to enter ↓</a></div>
    </div></section>
    <section class="statement" id="approach"><div class="statement-index">01 / APPROACH</div><p class="word-reveal">We transform earth, metal and memory into monumental works that belong to a place — and outlive a moment.</p><div class="statement-aside"><span>From first line</span><span>to final presence</span></div></section>
    <section class="projects" id="works"><div class="projects-sticky">
      <div class="projects-top"><span>02 / SELECTED WORKS</span><b>SCROLL TO EXPLORE</b><a href="/archive.html">ALL WORKS ↗</a></div>
      <div class="track">
        {collections.map((c) => (
          <a class={`slide project-card${c.invert ? ' invert' : ''}`} href={c.href}>
            <div class="media">
              <Image src={banner(c.banner)} alt={c.bannerAlt} widths={[640, 960, 1400, 1800]}
                     formats={['avif', 'webp']} sizes="(max-width: 760px) 100vw, 62vw"
                     quality={78} loading={c.n === '01' ? 'eager' : 'lazy'} />
            </div>
            <div class="caption">
              <span>COLLECTION {c.n} / {total} · {c.short}</span>
              <h3>{c.cardName.join(' ')}</h3>
              <p>{c.cardSub.join(' ')}</p>
            </div>
          </a>
        ))}
      </div><div class="track-line"><i></i></div>
    </div></section>
    <section class="material"><div class="material-bg"><img src="/motion/assets/samudra-manthana.jpg" alt="Samudra Manthana sculpture detail"></div><div class="material-copy"><span>03 / CRAFT</span><h2>EVERY<br><i>DETAIL</i><br>MATTERS.</h2></div><div class="material-notes"><p>Gesture</p><p>Surface</p><p>Scale</p><p>Silhouette</p></div></section>
    <section class="process">
      <div class="process-head"><span>04 / PROCESS</span><h2>From imagination<br>to <i>matter.</i></h2></div>
      <div class="process-visual"><div class="process-images"><img src="/motion/assets/yakshagana.jpg" alt="Yakshagana sculpture in progress"><img src="/motion/assets/shiva-hubli.jpg" alt="Shiva sculpture in progress"></div>
      <div class="process-steps"><article class="active"><b>01</b><h3>DRAW</h3><p>Define the rhythm and emotional centre.</p></article><article><b>02</b><h3>MODEL</h3><p>Build the form through clay and touch.</p></article><article><b>03</b><h3>CAST</h3><p>Carry every gesture into lasting material.</p></article><article><b>04</b><h3>PLACE</h3><p>Complete the work in its intended world.</p></article></div></div>
    </section>
    <section class="archive" id="archive"><div class="archive-head"><span>05 / ARCHIVE</span><h2>A LIVING<br><i>BODY OF WORK.</i></h2></div><div class="archive-grid">{collections.map((c) => (
      <a href={c.href}>
        <Image src={banner(c.banner)} alt={c.bannerAlt} widths={[640, 960, 1400]}
               formats={['avif', 'webp']} sizes="(max-width: 760px) 100vw, 48vw"
               quality={78} loading="lazy" />
        <span>{c.short} · {c.count} {c.count === 1 ? 'PROJECT' : 'PROJECTS'}</span>
      </a>
    ))}</div><a class="archive-all" href="/archive.html">VIEW COMPLETE ARCHIVE ↗</a></section>
    <section class="scrubber"><div class="scrub-copy"><span>06 / FROM CLAY TO PRESENCE</span><h2>Drag through<br>the process.</h2></div><div class="compare"><img src="/motion/assets/shiva-hubli.jpg" alt="Finished Shiva sculpture"><div class="compare-before"><img src="/motion/assets/yakshagana.jpg" alt="Yakshagana sculpture in progress"></div><button class="compare-handle" aria-label="Drag to compare the sculpture in progress with the finished sculpture"><i></i></button><span class="label-before">IN PROGRESS</span><span class="label-after">FINISHED</span></div></section>
    <section class="closing" id="contact"><div class="closing-ring"></div><p>07 / HAVE A STORY WORTH SHAPING?</p><h2>LET IT TAKE<br><i>FORM.</i></h2><a class="magnetic" href="mailto:contact@kalaayanastudios.com">BEGIN A COMMISSION <span>↗</span></a><div class="footer-links"><div><strong>KALAAYANA STUDIOS LLP</strong><span>Bengaluru, Karnataka<br>Monumental sculpture and sacred art</span></div><div><a href="mailto:contact@kalaayanastudios.com">Email the studio ↗</a><a href="https://instagram.com/kalaayana_studios" target="_blank" rel="noopener">Instagram ↗</a></div><nav aria-label="Footer navigation"><a href="/#works">Collections</a><a href="/archive.html">Archive</a><a href="/#approach">Approach</a></nav></div><div class="closing-foot"><span>KALAAYANA STUDIOS</span><span>BENGALURU · INDIA</span><span>© 2026</span></div></section>
  </main>
  <script is:inline src="/motion/motion.js?v=1.2.9"></script>
  <script is:inline src="/motion/phase.js?v=1.2.9"></script>
</body></html>
