---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { photo, photoWidths } from '../lib/photos';
import site from '../data/site.json';
import projects from '../data/projects.json';

export function getStaticPaths() {
  const groups = [...new Set(projects.map((p) => p.group))];
  return groups.map((section) => ({ params: { section } }));
}

const { section: key } = Astro.params;
const section = site.sections[key];
const items = projects.filter((p) => p.group === key);
const fonts =
  'https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap';
---

<Base
  title={`${section.eyebrow} — ${site.name}`}
  description={section.lede}
  fonts={fonts}
  bodyClass="motion-inner"
>
  <link slot="head" rel="stylesheet" href="/motion/inner.css?v=1.2.1" />

  <header class="inner-nav">
    <nav class="inner-links" aria-label="Page navigation">
      <a href="/preview.html#home">Home</a>
      <a href="/preview.html#works">Works</a>
      <a href="/preview.html#contact">Contact</a>
    </nav>
  </header>

  <main>
    <section class="collection-hero">
      <div class="collection-heading">
        <h1>{section.eyebrow}</h1>
      </div>
    </section>

    <section
      class="collection-grid"
      data-project-count={items.length}
      aria-label={`${section.eyebrow} projects`}
    >
      {items.map((project, index) => (
        <a class="work-tile" href={`/${key}/${project.slug}.html`}>
          <div class="work-image">
            <Image
              src={photo(project.images[0].file)}
              alt={project.images[0].alt}
              widths={photoWidths(photo(project.images[0].file))}
              quality={95}
              formats={['avif', 'webp']}
              loading={index < 2 ? 'eager' : 'lazy'}
              sizes={
                items.length <= 4
                  ? '(max-width: 760px) 90vw, 44vw'
                  : '(max-width: 760px) 90vw, (max-width: 1200px) 44vw, 30vw'
              }
            />
          </div>
          <div class="work-meta">
            <h2>{project.title}</h2>
            <p>
              {project.scale}
              {project.images[0].generated && (
                <>
                  <br />
                  AI-generated finish visualization
                </>
              )}
            </p>
          </div>
        </a>
      ))}
    </section>
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('.collection-grid').forEach((grid) => {
    if (Number(grid.dataset.projectCount) <= 2) return;
    let frame = 0;
    const pack = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const mobile = matchMedia('(max-width: 760px)').matches;
        grid.classList.toggle('masonry-ready', !mobile);
        const gap = parseFloat(getComputedStyle(grid).rowGap);
        grid.querySelectorAll<HTMLElement>('.work-tile').forEach((tile) => {
          tile.style.gridRowEnd = mobile
            ? ''
            : `span ${Math.ceil((tile.getBoundingClientRect().height + gap) / (1 + gap))}`;
        });
      });
    };
    const observer = new ResizeObserver(pack);
    grid.querySelectorAll('.work-tile').forEach((tile) => observer.observe(tile));
    window.addEventListener('resize', pack);
    document.fonts.ready.then(pack);
    pack();
  });
</script>

<style is:global>
  body.motion-inner main .collection-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 24px;
    align-items: start;
  }
  body.motion-inner main .collection-grid.masonry-ready {
    grid-auto-rows: 1px;
  }
  body.motion-inner main .collection-grid[data-project-count='4'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  body.motion-inner main .collection-grid:is([data-project-count='1'], [data-project-count='2']) {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60svh;
  }
  body.motion-inner
    .collection-grid:is([data-project-count='1'], [data-project-count='2'])
    .work-tile {
    flex: 0 1 680px;
    min-width: 0;
  }
  body.motion-inner .collection-grid .work-tile {
    display: inline-block;
    width: 100%;
    margin: 0;
    vertical-align: top;
    break-inside: avoid;
  }
  body.motion-inner .collection-grid .work-image {
    display: block;
    aspect-ratio: auto;
    height: auto;
    border-radius: 16px;
    overflow: hidden;
  }
  body.motion-inner .collection-grid .work-image img {
    width: 100%;
    height: auto;
    max-height: none;
    filter: none;
  }
  @media (min-width: 761px) and (max-width: 1200px) {
    body.motion-inner main .collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    body.motion-inner main .collection-grid,
    body.motion-inner main .collection-grid[data-project-count='4'] {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }
    body.motion-inner main .collection-grid:is([data-project-count='1'], [data-project-count='2']) {
      flex-direction: column;
      min-height: 0;
    }
    body.motion-inner
      .collection-grid:is([data-project-count='1'], [data-project-count='2'])
      .work-tile {
      flex: none;
    }
  }
</style>
