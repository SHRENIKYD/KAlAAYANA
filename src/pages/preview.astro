---
/**
 * The five-generation story lives in site.json and was rendered nowhere. The
 * menu now points at this section, so it carries the story itself rather than
 * the approach line alone. Read, not retyped.
 */
import site from '../data/site.json';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="description" content="Kalaayana Studios — monumental sculpture and sacred art shaped in Bengaluru.">
  <title>Kalaayana Studios — Art in Motion</title>
  <link rel="icon" type="image/png" href="/assets/img/favicon-title.png">
  <link rel="stylesheet" href="/motion/styles.css">
  <link rel="stylesheet" href="/motion/effects.css">
  <link rel="stylesheet" href="/motion/phase.css">
  <link rel="stylesheet" href="/motion/logo.css">
  <link rel="stylesheet" href="/motion/routing.css">
  <link rel="stylesheet" href="/motion/responsive.css">
  <link rel="stylesheet" href="/motion/collections.css">
  <link rel="stylesheet" href="/motion/home-theme.css">
</head>
<body class="homepage">
  <div class="cursor"><span>VIEW</span></div><div class="scroll-progress"></div><div class="section-meter" aria-hidden="true"><b>01</b><i></i><span>05</span></div>
  <header class="nav">
    <p>SCULPTURE STUDIO<br>BENGALURU, INDIA</p>
    <div class="nav-actions"><button class="menu" aria-label="Open navigation"><span>MENU</span><i></i></button></div>
  </header>
  <aside class="menu-panel" aria-hidden="true"><img class="menu-logo" src="/motion/assets/logo.svg" alt="Kalaayana Studios"><button class="menu-close">CLOSE ×</button><div class="menu-preview"><img src="/motion/assets/hero-hanuman.jpg" alt=""></div><nav><a href="#story"><b>01</b>Our story</a><a href="#archive"><b>02</b>Gallery</a><a href="#contact"><b>03</b>Contact</a></nav><div class="menu-meta">KALAAYANA STUDIOS · BENGALURU</div></aside>
  <main>
    <section class="hero" id="home"><div class="hero-sticky">
      <div class="hero-image" data-zoom><picture><source media="(max-width: 760px)" srcset="/motion/assets/gopuram-phone.jpg"><source media="(orientation: portrait)" srcset="/motion/assets/gopuram-tablet.jpg"><source media="(min-aspect-ratio: 2/1)" srcset="/motion/assets/gopuram-ultrawide.jpg"><source media="(min-width: 1700px)" srcset="/motion/assets/gopuram-desktop.jpg"><img src="/motion/assets/gopuram-laptop.jpg" alt="A gopuram niche carrying Ganesha with a child figure, cream stucco against blue-grey temple stone"></picture></div><div class="hero-shade"></div>
      <img class="hero-brand-logo" src="/motion/assets/hero-logo.png" alt="Kalaayana Studios" width="1472" height="762" fetchpriority="high">
      <div class="hero-title hero-brand">
        <div class="hero-brand-copy"><div class="hero-kicker">ART · DESIGN · LEGACY</div><h1><span>BESPOKE BY VISION.</span><span></span>TIMELESS<span><i>BY VISION.</i></span></h1></div>
      </div>
    </div></section>
    
    <section class="projects collection-index" id="works" aria-labelledby="works-title">
      <div class="collections-inner">
        <h2 class="collections-label" id="works-title">WORKS</h2>
        <a class="collection-feature" href="/temples.html">
          <img src="/motion/assets/temples.jpg" alt="Intricately sculpted Kalaayana temple façade" loading="lazy" width="1200" height="900">
          <div class="collection-feature-copy"><span>01 / SACRED SPACES</span><h3>Temple Architecture</h3><span class="collection-link">Discover collection <span aria-hidden="true">↗</span></span></div>
        </a>
        <a class="collection-feature" href="/portraits.html">
          <img src="/motion/assets/portraits.jpg" alt="Kalaayana sculpted portrait" loading="lazy" width="1200" height="900">
          <div class="collection-feature-copy"><span>02 / PORTRAITURE</span><h3>Potrtait</h3><span class="collection-link">Discover collection <span aria-hidden="true">↗</span></span></div>
        </a>
        <a class="collection-feature" href="/murals.html">
          <img src="/motion/assets/murals.jpg" alt="Narrative relief mural by Kalaayana" loading="lazy" width="1200" height="900">
          <div class="collection-feature-copy"><span>03 / NARRATIVE RELIEF</span><h3>Murals</h3><span class="collection-link">Discover collection <span aria-hidden="true">↗</span></span></div>
        </a>
        <a class="collection-feature" href="/landmarks.html">
          <img src="/motion/assets/landmarks.jpg" alt="Monumental public sculpture by Kalaayana" loading="lazy" width="1200" height="900">
          <div class="collection-feature-copy"><span>04 / LANDMARKS</span><h3>Monumental</h3><span class="collection-link">Discover collection <span aria-hidden="true">↗</span></span></div>
        </a>
        <a class="collection-feature" href="/installations.html">
          <img src="/motion/assets/installations.jpg" alt="Oversized sculptural installation by Kalaayana" loading="lazy" width="1200" height="900">
          <div class="collection-feature-copy"><span>05 / EXPERIENTIAL</span><h3>Architectural Installations</h3><span class="collection-link">Discover collection <span aria-hidden="true">↗</span></span></div>
        </a>
      </div>
    </section>
    <section class="material"><div class="material-bg"><img src="/motion/assets/samudra-manthana.jpg" alt="Samudra Manthana sculpture detail"></div><div class="material-copy"><span>01 / CRAFT</span><h2>EVERY<br><i>DETAIL</i><br>MATTERS.</h2></div><div class="material-notes"><p>Gesture</p><p>Surface</p><p>Scale</p><p>Silhouette</p></div></section>
    <section class="process">
      <div class="process-head"><span>02 / PROCESS</span><h2>From imagination<br>to <i>matter.</i></h2></div>
      <div class="process-visual"><div class="process-images"><img src="/motion/assets/yakshagana.jpg" alt="Yakshagana sculpture in progress"><img src="/motion/assets/shiva-hubli.jpg" alt="Shiva sculpture in progress"></div>
      <div class="process-steps"><article><b>01</b><h3>DRAW</h3><p>Define the rhythm and emotional centre.</p></article><article><b>02</b><h3>MODEL</h3><p>Build the form through clay and touch.</p></article><article><b>03</b><h3>CAST</h3><p>Carry every gesture into lasting material.</p></article><article><b>04</b><h3>PLACE</h3><p>Complete the work in its intended world.</p></article></div></div>
    </section>
    <section class="archive" id="archive"><div class="archive-head"><span>03 / ARCHIVE</span><h2>A LIVING<br><i>BODY OF WORK.</i></h2></div><div class="archive-grid"><figure><img src="/motion/assets/portraits.jpg" alt="Portrait sculpture"><figcaption>PORTRAITURE · 18 WORKS</figcaption></figure><figure><img src="/motion/assets/murals.jpg" alt="Mural sculpture"><figcaption>MURALS · 12 WORKS</figcaption></figure><figure><img src="/motion/assets/landmarks.jpg" alt="Landmark sculpture"><figcaption>LANDMARKS · 09 WORKS</figcaption></figure><figure><img src="/motion/assets/temples.jpg" alt="Temple sculpture"><figcaption>SACRED SPACES · 24 WORKS</figcaption></figure></div></section>
    <section class="scrubber"><div class="scrub-copy"><span>FROM CLAY TO PRESENCE</span><h2>Drag through<br>the process.</h2></div><div class="compare"><img src="/motion/assets/shiva-hubli.jpg" alt="Finished sculpture"><div class="compare-before"><img src="/motion/assets/yakshagana.jpg" alt="Sculpture in progress"></div><button class="compare-handle" aria-label="Compare process stages"><i></i></button><span class="label-before">PROCESS</span><span class="label-after">PRESENCE</span></div></section>
    <section class="statement" id="story"><div class="statement-index">04 / OUR STORY</div><div class="story-grid"><div class="story-main"><h2>Our story</h2>{site.story.map((paragraph) => <p set:html={paragraph} />)}</div><div class="story-expertise"><h2>Expertise</h2><ul>{site.expertise.map((item) => <li>{item.title}</li>)}</ul><p class="story-materials">Materials — {site.materials.join(" · ")}</p></div></div><p class="story-sign">Team, Kalaayana Studios</p></section><section class="closing" id="contact"><div class="closing-ring"></div><p>HAVE A STORY WORTH SHAPING?</p><h2>LET IT TAKE<br><i>FORM.</i></h2><a class="magnetic" href="mailto:hello@kalaayanastudios.com">BEGIN A COMMISSION <span>↗</span></a><div class="closing-foot"><span>KALAAYANA STUDIOS</span><span>BENGALURU · INDIA</span><span>© 2026</span></div></section>
  </main>
  <script is:inline src="/motion/motion.js"></script>
  <script is:inline src="/motion/phase.js"></script>
</body></html>
