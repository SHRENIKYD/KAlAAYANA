---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import projects from '../data/projects.json';

const fonts = 'https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap';
const groups = Object.entries(site.sections).map(([key, section], index) => ({
  key,
  section,
  label: key === 'landmarks' ? 'Landmarks' : section.eyebrow,
  index: String(index + 1).padStart(2, '0'),
  count: projects.filter((project) => project.group === key).length,
}));
---
<Base title={`Archive — ${site.name}`} description="Explore every Kalaayana Studios collection." fonts={fonts} bodyClass="motion-inner">
  <link slot="head" rel="stylesheet" href="/motion/inner.css?v=1.2.8">
  <style slot="head" is:inline>
    .archive-page{min-height:100vh;background:#0c0b0a;color:#e9e4da;padding:160px 5vw 12vw}
    .archive-page header{display:grid;grid-template-columns:1fr 4fr;align-items:end;margin-bottom:9vw}
    .archive-page header span,.archive-card small{font:400 .62rem 'DM Sans',sans-serif;letter-spacing:.18em;text-transform:uppercase}
    .archive-page h1{margin:0;font:400 clamp(5rem,11vw,12rem)/.75 'Instrument Serif',serif;letter-spacing:-.045em}
    .archive-page h1 i{color:#d5b37a;font-weight:400}.archive-list{border-top:1px solid #ffffff35}
    .archive-card{display:grid;grid-template-columns:90px 1fr auto;gap:3vw;align-items:center;color:inherit;text-decoration:none;padding:42px 0;border-bottom:1px solid #ffffff35}
    .archive-card h2{margin:0;font:400 clamp(3rem,6vw,7rem)/.85 'Instrument Serif',serif;letter-spacing:-.03em}.archive-card p{margin:0;text-align:right;font-size:.66rem;line-height:1.7;letter-spacing:.12em;text-transform:uppercase;color:#bdb5a9}
    .archive-card:hover h2{color:#d5b37a}
    @media(max-width:760px){.archive-page{padding:115px 24px 90px}.archive-page header{display:block;margin-bottom:70px}.archive-page header span{display:block;margin-bottom:50px}.archive-page h1{font-size:21vw}.archive-card{grid-template-columns:44px 1fr;padding:30px 0}.archive-card h2{font-size:13vw}.archive-card p{grid-column:2;text-align:left}}
  </style>
  <header class="inner-nav"><a class="logo" href="/"><img src="/motion/assets/logo.svg" alt="Kalaayana Studios"></a><p>SCULPTURE STUDIO<br>BENGALURU, INDIA</p><nav class="inner-links" aria-label="Page navigation"><a href="/#works">Collections</a><a href="/#contact">Contact</a></nav></header>
  <main class="archive-page">
    <header><span>Complete archive</span><h1>Five bodies<br>of <i>work.</i></h1></header>
    <nav class="archive-list" aria-label="Kalaayana collections">
      {groups.map(({ key, label, index, count }) => <a class="archive-card" href={`/${key}.html`}><small>{index}</small><h2>{label}</h2><p>{count} {count === 1 ? 'project' : 'projects'}<br>Explore collection ↗</p></a>)}
    </nav>
  </main>
</Base>
