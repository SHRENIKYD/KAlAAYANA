---
/**
 * One temple project. Generated for every project in the group, so adding a
 * project to the data adds its page — no route is written by hand.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { photo } from '../../lib/photos';
import site from '../../data/site.json';
import projects from '../../data/projects.json';

const GROUP = 'temples';

export function getStaticPaths() {
  /* Astro evaluates this in isolation, so the group is named here rather than
     read from a module-scope constant. */
  return projects
    .filter((p) => p.group === 'temples')
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const section = site.sections[GROUP];
const siblings = projects.filter((p) => p.group === GROUP && p.slug !== project.slug);
const fonts = 'https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Jost:wght@200;300;400;500&display=swap';
---
<Base title={`${project.title} — ${site.name}`} description={project.description} fonts={fonts}>
  <link slot="head" rel="stylesheet" href="/assets/css/style.css?v=dev">

  <div class="scroll-progress" id="scrollProgress"></div>
  <header class="site-header solid" id="siteHeader">
    <a class="brand" href="/preview.html">
      <span class="brand-text">Kalaayana<em>Studios</em></span>
    </a>
    <nav class="nav" id="nav">
      {site.nav.map((n) => <a href={`/preview.html${n.href}`}>{n.label}</a>)}
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </header>

  <main class="section subpage">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/preview.html">Home</a><span aria-hidden="true">/</span>
        <a href="/temples.html">{section.eyebrow}</a><span aria-hidden="true">/</span>
        <span>{project.title}</span>
      </nav>

      <div class="project">
        <figure class="project-media" data-reveal>
          <Image src={photo(project.image)} alt={project.alt}
                 widths={[640, 960, 1400]} formats={['avif', 'webp']} loading="eager"
                 sizes="(max-width: 900px) 92vw, 60vw" />
        </figure>
        <div class="project-body" data-reveal data-delay="120">
          <h1 class="section-title">{project.title}</h1>
          <dl class="project-facts">
            <div><dt>Scale</dt><dd>{project.scale}</dd></div>
            <div><dt>Section</dt><dd>{section.eyebrow}</dd></div>
          </dl>
          <p class="project-note">{project.description}</p>
          <a class="btn btn-ghost" href="/temples.html">Back to {section.eyebrow}</a>
        </div>
      </div>

      {siblings.length > 0 && (
        <section class="more">
          <h2 class="more-title">More in {section.eyebrow}</h2>
          <div class="grid four">
            {siblings.map((p, i) => (
              <a class="card" href={`/temples/${p.slug}.html`} data-reveal data-delay={i * 80} data-tilt>
                <div class="card-media">
                  <Image src={photo(p.image)} alt={p.alt}
                         widths={[400, 800]} formats={['avif', 'webp']} loading="lazy"
                         sizes="(max-width: 620px) 92vw, 30vw" />
                </div>
                <div class="card-body">
                  <span class="card-scale">{p.scale}</span>
                  <h3>{p.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <span>© <span id="year"></span> Kalaayana Studios LLP</span>
      <span class="footer-note">Photography of the studio's own work.</span>
    </div>
  </footer>

  <script is:inline src="/assets/js/main.js?v=dev"></script>
</Base>
