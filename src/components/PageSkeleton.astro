---
/**
 * The page's own shape, shown over the viewport from the first paint until
 * the page has loaded (or 1.8 s, whichever comes first), so a slow connection
 * sees where the title, the photographs and the text will be rather than a
 * blank or half-drawn page. Inert without the head script that adds
 * html.skel-wait; skeleton.js takes it away.
 */
interface Props {
  kind: 'home' | 'holding' | 'section' | 'project' | 'collectables' | 'policy';
}
const { kind } = Astro.props;
// Inline, so the shape is there before any stylesheet arrives.
const styles = `.pskel {
  display: none;
}
html.skel-wait .pskel {
  display: block;
  position: fixed;
  inset: 0;
  z-index: 9000;
  overflow: hidden;
  background: #0b0a09;
  --sk: rgba(255, 255, 255, 0.07);
  --sk-hi: rgba(255, 255, 255, 0.13);
  transition: opacity 0.25s ease;
}
html.skel-wait.skel-done .pskel {
  opacity: 0;
  pointer-events: none;
}
html.skel-wait .pskel-policy {
  background: #e9e4da;
  --sk: rgba(26, 24, 22, 0.08);
  --sk-hi: rgba(26, 24, 22, 0.14);
}
.pskel-block,
.pskel-line,
.pskel-title,
.pskel-mark {
  display: block;
  background: linear-gradient(90deg, var(--sk) 25%, var(--sk-hi) 50%, var(--sk) 75%);
  background-size: 200% 100%;
  animation: skel-shimmer 1.4s ease-in-out infinite;
  border-radius: 3px;
}
.pskel-line {
  height: 12px;
  margin: 10px 0;
  width: 100%;
}
.pskel-line.short {
  width: 62%;
}
.pskel-eyebrow {
  width: 120px;
  height: 10px;
}
.pskel-lede {
  width: min(520px, 70%);
}
.pskel-title {
  width: min(420px, 60%);
  height: 48px;
  margin: 14px 0 18px;
}
/* home and holding: the hero with the mark */
.pskel-hero {
  height: 72vh;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 18px;
}
.pskel-mark {
  width: min(360px, 60vw);
  height: 84px;
  border-radius: 42px;
}
.pskel-kicker {
  width: 160px;
  height: 10px;
}
.pskel-tiles {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  padding: 24px 5vw;
}
.pskel-tiles .pskel-block {
  aspect-ratio: 4 / 3;
}
/* section and collectables: cream band with the title, then the grid */
.pskel-band {
  background: #e9e4da;
  --sk: rgba(26, 24, 22, 0.08);
  --sk-hi: rgba(26, 24, 22, 0.14);
  min-height: 42vh;
  padding: 150px 5vw 48px;
  box-sizing: border-box;
}
.pskel-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  padding: 36px 5vw;
}
/* project: the photograph and the words beside it */
.pskel-detail {
  padding: 140px 5vw 0;
}
.pskel-detail-body {
  display: grid;
  grid-template-columns: 3fr 2fr;
  gap: 40px;
  align-items: start;
}
.pskel-frame {
  aspect-ratio: 4 / 3;
}
.pskel-text {
  padding-top: 8px;
}
/* policy: a document */
.pskel-doc {
  max-width: 760px;
  margin: 0 auto;
  padding: 140px 5vw 0;
}
@media (max-width: 820px) {
  .pskel-tiles,
  .pskel-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .pskel-detail-body {
    grid-template-columns: 1fr;
  }
  .pskel-band {
    padding-top: 110px;
    min-height: 34vh;
  }
  .pskel-detail,
  .pskel-doc {
    padding-top: 100px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .pskel-block,
  .pskel-line,
  .pskel-title,
  .pskel-mark {
    animation: none;
  }
}
@keyframes skel-shimmer {
  from {
    background-position: 200% 0;
  }
  to {
    background-position: -200% 0;
  }
}
`;
const cards = kind === 'collectables' ? [1, 1, 1, 1, 1, 1, 1, 1] : [0.9, 1.3, 1, 1.15, 0.85, 1.05];
---

<style is:inline set:html={styles}></style>
<div class={`pskel pskel-${kind}`} aria-hidden="true">
  {(kind === 'home' || kind === 'holding') && (
    <div class="pskel-hero">
      <span class="pskel-mark" />
      <span class="pskel-line pskel-kicker" />
    </div>
  )}
  {kind === 'home' && (
    <div class="pskel-tiles">
      <span class="pskel-block" />
      <span class="pskel-block" />
      <span class="pskel-block" />
    </div>
  )}
  {(kind === 'section' || kind === 'collectables') && (
    <>
      <div class="pskel-band">
        <span class="pskel-line pskel-eyebrow" />
        <span class="pskel-title" />
        <span class="pskel-line pskel-lede" />
      </div>
      <div class="pskel-grid">
        {cards.map((h) => (
          <span
            class="pskel-block"
            style={`aspect-ratio: ${kind === 'collectables' ? '1' : `4 / ${(h * 4).toFixed(2)}`}`}
          />
        ))}
      </div>
    </>
  )}
  {kind === 'project' && (
    <div class="pskel-detail">
      <span class="pskel-line pskel-eyebrow" />
      <span class="pskel-title" />
      <div class="pskel-detail-body">
        <span class="pskel-block pskel-frame" />
        <div class="pskel-text">
          <span class="pskel-line" />
          <span class="pskel-line" />
          <span class="pskel-line short" />
          <span class="pskel-line" />
          <span class="pskel-line short" />
        </div>
      </div>
    </div>
  )}
  {kind === 'policy' && (
    <div class="pskel-doc">
      <span class="pskel-title" />
      {[1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
        <span class={`pskel-line${i % 4 === 0 ? ' short' : ''}`} />
      ))}
    </div>
  )}
</div>
