---
import site from '../data/site.json';
import releaseVersion from '../../VERSION?raw';
const year = new Date().getFullYear();
const version = releaseVersion.trim();
---

<footer class="policy-links">
  <small class="copyright">
    &copy; {year} {site.legalName}
  </small>
  <nav class="policy-navigation" aria-label="Website policies">
    <a href="/policies/privacy.html">Privacy policy</a>
    <a href="/policies/terms.html">Terms of use</a>
    <a href="/policies/commissions.html">Commission &amp; refund policy</a>
    <a href="/policies/copyright.html">Copyright &amp; licences</a>
  </nav>
  <small class="site-version" aria-label={`Website version ${version}`}>
    Version {version}
  </small>
</footer>

<style>
  .policy-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 22px;
    padding: 20px 5vw;
    background: #191816;
    color: #bcb5a9;
    font:
      400 0.75rem/1.6 'DM Sans',
      Arial,
      sans-serif;
  }
  .policy-navigation {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
  }
  .policy-links a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  .copyright {
    font-size: inherit;
  }
  .site-version {
    font-size: 0.7rem;
    color: #c1b7a6;
  }
  .policy-links a:hover {
    color: #e9e4da;
    text-decoration: underline;
  }
  .policy-links a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }
</style>
