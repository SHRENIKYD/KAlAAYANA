---
import clients from '../data/clients.json';
---

<section class="client-strip" aria-labelledby="clients-title">
  <header>
    <h2 id="clients-title">Our clients</h2>
  </header>
  <div class="client-window">
    <div class="client-track">
      {[false, true].map((duplicate) => (
        <ul class="client-group" aria-hidden={duplicate ? 'true' : undefined}>
          {clients.map((client) => (
            <li
              class="client-item"
              tabindex={duplicate ? undefined : '0'}
              aria-label={client.name}
              title={client.name}
            >
              {client.logo ? (
                <img src={client.logo} alt={client.name} loading="lazy" decoding="async" />
              ) : (
                <span>{client.name}</span>
              )}
              {client.logo && (
                <span class="client-name" aria-hidden="true">
                  {client.name}
                </span>
              )}
            </li>
          ))}
        </ul>
      ))}
    </div>
    <div class="client-color-layer" aria-hidden="true">
      <div class="client-track">
        {[false, true].map(() => (
          <ul class="client-group">
            {clients.map((client) => (
              <li class="client-item">
                {client.logo ? (
                  <img src={client.logo} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span>{client.name}</span>
                )}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .client-strip {
    background: var(--home-paper, #e9e4da);
    color: var(--home-ink, #171512);
    padding: 48px var(--page-gutter, 5vw) 56px;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    border-top: 1px solid #b9b0a0;
    padding-top: 24px;
  }
  h2 {
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0;
  }
  .client-window {
    position: relative;
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    overflow: hidden;
    margin-top: 20px;
  }
  .client-color-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent 5%, #000 45%, #000 55%, transparent 95%);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 5%,
      #000 45%,
      #000 55%,
      transparent 95%
    );
  }
  .client-color-layer .client-item {
    opacity: 1;
  }
  .client-color-layer .client-item img {
    filter: none;
  }
  .client-color-layer .client-item img[src$='oia.svg'] {
    filter: brightness(0);
  }
  .client-track {
    display: flex;
    width: max-content;
    animation: client-drift 110s linear infinite;
  }
  .client-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .client-item {
    position: relative;
    width: 210px;
    height: 140px;
    padding: 20px 28px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
    transition: opacity 160ms ease;
  }
  .client-item .client-name {
    position: absolute;
    bottom: 0;
    left: 8px;
    right: 8px;
    z-index: 2;
    font-family: inherit;
    font-size: 11px;
    line-height: 1.3;
    text-align: center;
    color: var(--home-ink, #171512);
    opacity: 0;
    pointer-events: none;
  }
  .client-item:focus-visible .client-name {
    opacity: 1;
  }
  .client-item img {
    display: block;
    max-width: 100%;
    max-height: 80px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
  }
  .client-item
    img:is([src*='brahma-brews'], [src*='habitart-solutions'], [src*='cauvery-janma-bhoomi']) {
    border-radius: 50%;
    width: 80px;
    height: 80px;
    object-fit: cover;
  }
  .client-item img[src*='cauvery-janma-bhoomi'] {
    border-radius: 0;
    clip-path: circle(39% at 46% 53%);
    transform: translate(3px, -2px) scale(1.2);
  }
  .client-item img[src*='kempegowda'] {
    mix-blend-mode: multiply;
  }
  .client-item span {
    font-family: Georgia, serif;
    font-size: 20px;
    line-height: 1.25;
    text-align: center;
  }
  .client-item img[src$='oia.svg'] {
    filter: brightness(0);
  }
  .client-item:focus-visible {
    outline: 1px solid #8b7548;
    outline-offset: -8px;
    opacity: 1;
  }
  .client-item:focus-visible img {
    filter: none;
  }
  .client-strip:focus-within .client-track {
    animation-play-state: paused;
  }
  @media (hover: hover) and (pointer: fine) {
    .client-window:hover .client-track {
      animation-play-state: paused;
    }
    .client-item:hover .client-name {
      opacity: 1;
    }
    .client-item:hover {
      opacity: 1;
    }
    .client-item:hover img {
      filter: none;
    }
  }
  @keyframes client-drift {
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 600px) {
    .client-strip {
      padding-block: 32px;
    }
    .client-item {
      width: 175px;
      height: 120px;
      padding: 20px;
    }
    .client-item
      img:is([src*='brahma-brews'], [src*='habitart-solutions'], [src*='cauvery-janma-bhoomi']) {
      border-radius: 50%;
      width: 80px;
      height: 80px;
      object-fit: cover;
    }
    .client-item span {
      font-size: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .client-color-layer {
      display: none;
    }
    .client-track {
      animation: none;
    }
    .client-window {
      mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
      overflow-x: auto;
    }
    .client-group[aria-hidden] {
      display: none;
    }
  }
</style>
