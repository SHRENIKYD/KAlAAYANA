---
/**
 * Shared document shell. Owns <head>
    <script is:inline src="/motion/diagnostics.js"></script> and nothing else — pages supply their
 * own body. Presentation depends on this; it depends on no page.
 */
import site from '../data/site.json';
import { LIVE } from '../lib/live';
import Seo from '../components/Seo.astro';
import PolicyLinks from '../components/PolicyLinks.astro';

interface Props {
  title: string;
  description?: string;
  /** Pages are indexable once the site is live; before that only the holding page is. */
  indexable?: boolean;
  fonts: string;
  bodyClass?: string;
}

const { title, description = site.description, indexable = LIVE, fonts, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('skel-wait');
      setTimeout(function () {
        document.documentElement.classList.remove('skel-wait');
      }, 4000);
    </script>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <Seo {title} {description} />
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts} rel="stylesheet" />
    <slot name="head" />
    <link rel="stylesheet" href="/motion/page-spacing.css" />
    <link rel="stylesheet" href="/motion/skeleton.css" />
    <script src="/motion/skeleton.js" defer></script>
    {site.analytics?.cloudflareBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: site.analytics.cloudflareBeaconToken })}
      />
    )}
  </head>
  <body class:list={['site-shell', bodyClass]}>
    <slot />
    <div class="site-footer">
      <PolicyLinks />
    </div>
  </body>
</html>
